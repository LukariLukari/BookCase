# Persistent PostgreSQL connection used directly by Next.js/Prisma on Vercel.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require

# Keep this stable; changing it signs out all devices.
JWT_SECRET=replace-with-a-long-random-secret

# Creates the first admin only when that username does not exist yet.
ADMIN_USERNAME=admin
ADMIN_SETUP_KEY=replace-with-a-strong-first-admin-password

# Web Push: run npm run push:keys once, then copy the generated values here.
# Keep the pair stable. Rotating it requires devices to subscribe again.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:your-real-email@example.com

# Vercel automatically includes this as Authorization: Bearer ... for cron calls.
CRON_SECRET=
