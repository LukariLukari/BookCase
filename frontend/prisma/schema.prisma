generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  email         String?  @unique
  password_hash String
  role          String   @default("user")
  createdAt     DateTime @default(now())

  // Relations
  products            BusinessProduct[]
  transactions        BusinessTransaction[]
  ledgers             BusinessLedger[]
  receipts            BusinessStockReceipt[]
  orders              BusinessOrder[]
  expenses            BusinessExpense[]
  customers           BusinessCustomer[]
  orderPayments       BusinessOrderPayment[]
  statusHistory       BusinessOrderStatusHistory[]
  stockMovements      BusinessInventoryMovement[]
  inventoryBatches    BusinessInventoryBatch[]
  businessBackups     BusinessDataBackup[]
  expenseBooks        ExpenseBook[]
  moneyAccounts       MoneyAccount[]
  financeTransactions FinanceTransaction[]
  financeCategories   FinanceCategory[]
  moneyAccountEdits   MoneyAccountEdit[]
  subscriptions       CustomerSubscription[]
  subscriptionApps    SubscriptionApp[]
  pushDevices         SubscriptionPushDevice[]
}

// Device registrations intentionally stay out of portable business backups.
model SubscriptionPushDevice {
  id             String   @id @default(uuid())
  userId         String
  endpointHash   String   @unique
  endpoint       String
  p256dh         String
  auth           String
  vapidPublicKey String
  daysBefore     Int      @default(3)
  lastSentDate   String?
  lockedUntil    DateTime?
  lastTestAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SubscriptionApp {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model RegistrationCode {
  id             String   @id @default(uuid())
  code           String   @unique
  isUsed         Boolean  @default(false)
  usedByUsername String?
  createdBy      String?
  createdAt      DateTime @default(now())
}

model BusinessProduct {
  id            String   @id @default(uuid())
  userId        String
  name          String
  sku           String?
  category      String?
  imageUrl      String?
  sellingPrice  Int      @default(0)
  unitCost      Int      @default(0)
  stockQuantity Int      @default(0)
  trackStock    Boolean  @default(true)
  batchId       String?
  socialLink    String?
  supplierInfo  String?
  customerInfo  String?
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user           User                        @relation(fields: [userId], references: [id])
  transactions   BusinessTransaction[]
  receiptItems   BusinessStockReceiptItem[]
  orderItems     BusinessOrderItem[]
  stockMovements BusinessInventoryMovement[]
  batch          BusinessInventoryBatch?     @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([userId, isActive])
  @@index([userId, batchId])
}

model BusinessInventoryBatch {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  products BusinessProduct[]
  receipts BusinessStockReceipt[]

  @@index([userId, createdAt])
}

model BusinessTransaction {
  id              String   @id @default(uuid())
  userId          String
  productId       String?
  type            String // "income" or "expense"
  category        String
  amount          Int      @default(0)
  quantity        Int      @default(1)
  capitalCost     Int      @default(0)
  shippingFee     Int      @default(0)
  otherFee        Int      @default(0)
  customerName    String?
  customerContact String?
  socialLink      String?
  note            String?
  transactionDate DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    User             @relation(fields: [userId], references: [id])
  product BusinessProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model BusinessLedger {
  id          String   @id @default(uuid())
  userId      String
  name        String
  month       String // YYYY-MM
  openingCash Int      @default(0)
  note        String?
  isClosed    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id])
  orders   BusinessOrder[]
  expenses BusinessExpense[]
}

model BusinessStockReceipt {
  id           String   @id @default(uuid())
  userId       String
  batchId      String?
  code         String
  supplierName String?
  extraCost    Int      @default(0)
  note         String?
  receivedAt   DateTime
  createdAt    DateTime @default(now())

  user  User                       @relation(fields: [userId], references: [id])
  batch BusinessInventoryBatch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)
  items BusinessStockReceiptItem[]

  @@index([userId, batchId])
}

model BusinessStockReceiptItem {
  id        String @id @default(uuid())
  receiptId String
  productId String
  quantity  Int
  unitCost  Int    @default(0)

  receipt BusinessStockReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product BusinessProduct      @relation(fields: [productId], references: [id])
}

model BusinessOrder {
  id              String   @id @default(uuid())
  userId          String
  ledgerId        String
  code            String
  customerName    String
  customerContact String?
  socialLink      String?
  shippingFee     Int      @default(0)
  shippingCost    Int      @default(0)
  discount        Int      @default(0)
  otherFee        Int      @default(0)
  paymentStatus   String   @default("paid")
  status          String   @default("confirmed")
  note            String?
  orderedAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  customerId      String?

  user          User                         @relation(fields: [userId], references: [id])
  ledger        BusinessLedger               @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  items         BusinessOrderItem[]
  customer      BusinessCustomer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  payments      BusinessOrderPayment[]
  statusHistory BusinessOrderStatusHistory[]

  @@index([userId, ledgerId, orderedAt])
}

model BusinessCustomer {
  id         String   @id @default(uuid())
  userId     String
  name       String
  phone      String?
  email      String?
  socialLink String?
  address    String?
  tags       String[] @default([])
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders BusinessOrder[]
  subscriptions CustomerSubscription[]

  @@unique([userId, phone])
  @@index([userId, name])
}

model CustomerSubscription {
  id             String   @id @default(uuid())
  userId         String
  customerId     String?
  customerName   String
  customerContact String?
  appName        String
  planName       String?
  account        String
  durationValue  Int
  durationUnit   String
  price          Decimal  @db.Decimal(18, 2)
  currency       String   @default("VND")
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date
  cancelDate     DateTime @db.Date
  status         String   @default("active")
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer BusinessCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([userId, cancelDate])
  @@index([userId, status, cancelDate])
  @@index([userId, customerId])
}

model BusinessOrderPayment {
  id        String   @id @default(uuid())
  userId    String
  orderId   String
  amount    Int
  method    String   @default("cash")
  note      String?
  paidAt    DateTime @default(now())
  createdAt DateTime @default(now())

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  order BusinessOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId, orderId, paidAt])
}

model BusinessOrderStatusHistory {
  id         String   @id @default(uuid())
  userId     String
  orderId    String
  fromStatus String?
  toStatus   String
  note       String?
  createdAt  DateTime @default(now())

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  order BusinessOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId, orderId, createdAt])
}

model BusinessInventoryMovement {
  id            String   @id @default(uuid())
  userId        String
  productId     String
  type          String
  quantity      Int
  balanceAfter  Int
  referenceType String?
  referenceId   String?
  note          String?
  createdAt     DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product BusinessProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId, productId, createdAt])
}

model BusinessOrderItem {
  id          String @id @default(uuid())
  orderId     String
  productId   String
  productName String
  quantity    Int
  unitPrice   Int    @default(0)
  unitCost    Int    @default(0)

  order   BusinessOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product BusinessProduct @relation(fields: [productId], references: [id])
}

model BusinessExpense {
  id        String   @id @default(uuid())
  userId    String
  ledgerId  String
  category  String
  amount    Int      @default(0)
  note      String?
  spentAt   DateTime
  createdAt DateTime @default(now())

  user   User           @relation(fields: [userId], references: [id])
  ledger BusinessLedger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)

  @@index([userId, ledgerId, spentAt])
}

model BusinessDataBackup {
  id        String   @id @default(uuid())
  userId    String
  label     String
  source    String   @default("automatic")
  payload   Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ExpenseBook {
  id              String   @id @default(uuid())
  userId          String
  name            String
  defaultCurrency String   @default("VND")
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts     MoneyAccount[]
  transactions FinanceTransaction[]

  @@index([userId, createdAt])
}

model MoneyAccount {
  id             String   @id @default(uuid())
  userId         String
  bookId         String
  name           String
  type           String
  currency       String   @default("VND")
  openingBalance Decimal  @default(0) @db.Decimal(18, 2)
  creditLimit    Decimal? @db.Decimal(18, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  book              ExpenseBook          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  transactions      FinanceTransaction[] @relation("FinanceAccountTransactions")
  incomingTransfers FinanceTransaction[] @relation("FinanceDestinationAccount")
  editHistory       MoneyAccountEdit[]

  @@index([userId, bookId])
}

model MoneyAccountEdit {
  id                  String   @id @default(uuid())
  userId              String
  accountId           String
  previousName        String
  newName             String
  previousType        String
  newType             String
  previousCurrency    String
  newCurrency         String
  previousCreditLimit Decimal? @db.Decimal(18, 2)
  newCreditLimit      Decimal? @db.Decimal(18, 2)
  previousBalance     Decimal  @db.Decimal(18, 2)
  newBalance          Decimal  @db.Decimal(18, 2)
  note                String?
  createdAt           DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  account MoneyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId, accountId, createdAt])
}

model FinanceCategory {
  id        String   @id @default(uuid())
  userId    String
  name      String
  type      String
  icon      String
  color     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions FinanceTransaction[]

  @@unique([userId, type, name])
  @@index([userId, type, createdAt])
}

model FinanceTransaction {
  id                   String   @id @default(uuid())
  userId               String
  bookId               String
  accountId            String
  destinationAccountId String?
  categoryId           String?
  type                 String
  amount               Decimal  @db.Decimal(18, 2)
  currency             String   @default("VND")
  category             String
  description          String?
  transactionDate      DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  book               ExpenseBook      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  account            MoneyAccount     @relation("FinanceAccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)
  destinationAccount MoneyAccount?    @relation("FinanceDestinationAccount", fields: [destinationAccountId], references: [id], onDelete: Cascade)
  categoryRef        FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, bookId, transactionDate])
  @@index([userId, accountId])
  @@index([userId, destinationAccountId])
  @@index([userId, categoryId])
}
