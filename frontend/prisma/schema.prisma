generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  email         String?  @unique
  password_hash String
  role          String   @default("user")
  createdAt     DateTime @default(now())

  // Relations
  products      BusinessProduct[]
  transactions  BusinessTransaction[]
  ledgers       BusinessLedger[]
  receipts      BusinessStockReceipt[]
  orders        BusinessOrder[]
  expenses      BusinessExpense[]
  customers     BusinessCustomer[]
  orderPayments BusinessOrderPayment[]
  statusHistory BusinessOrderStatusHistory[]
  stockMovements BusinessInventoryMovement[]
}

model RegistrationCode {
  id               String   @id @default(uuid())
  code             String   @unique
  isUsed           Boolean  @default(false)
  usedByUsername   String?
  createdBy        String?
  createdAt        DateTime @default(now())
}

model BusinessProduct {
  id              String   @id @default(uuid())
  userId          String
  name            String
  sku             String?
  category        String?
  imageUrl        String?
  sellingPrice    Int      @default(0)
  unitCost        Int      @default(0)
  stockQuantity   Int      @default(0)
  socialLink      String?
  supplierInfo    String?
  customerInfo    String?
  notes           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id])
  transactions    BusinessTransaction[]
  receiptItems    BusinessStockReceiptItem[]
  orderItems      BusinessOrderItem[]
  stockMovements  BusinessInventoryMovement[]

  @@index([userId, isActive])
}

model BusinessTransaction {
  id              String   @id @default(uuid())
  userId          String
  productId       String?
  type            String   // "income" or "expense"
  category        String
  amount          Int      @default(0)
  quantity        Int      @default(1)
  capitalCost     Int      @default(0)
  shippingFee     Int      @default(0)
  otherFee        Int      @default(0)
  customerName    String?
  customerContact String?
  socialLink      String?
  note            String?
  transactionDate DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id])
  product         BusinessProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model BusinessLedger {
  id          String   @id @default(uuid())
  userId      String
  name        String
  month       String   // YYYY-MM
  openingCash Int      @default(0)
  note        String?
  isClosed    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])
  orders      BusinessOrder[]
  expenses    BusinessExpense[]
}

model BusinessStockReceipt {
  id           String   @id @default(uuid())
  userId       String
  code         String
  supplierName String?
  extraCost    Int      @default(0)
  note         String?
  receivedAt   DateTime
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id])
  items        BusinessStockReceiptItem[]
}

model BusinessStockReceiptItem {
  id         String   @id @default(uuid())
  receiptId  String
  productId  String
  quantity   Int
  unitCost   Int      @default(0)

  receipt    BusinessStockReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product    BusinessProduct      @relation(fields: [productId], references: [id])
}

model BusinessOrder {
  id              String   @id @default(uuid())
  userId          String
  ledgerId        String
  code            String
  customerName    String
  customerContact String?
  socialLink      String?
  shippingFee     Int      @default(0)
  shippingCost    Int      @default(0)
  discount        Int      @default(0)
  otherFee        Int      @default(0)
  paymentStatus   String   @default("paid")
  status          String   @default("confirmed")
  note            String?
  orderedAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  customerId      String?

  user            User            @relation(fields: [userId], references: [id])
  ledger          BusinessLedger  @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  items           BusinessOrderItem[]
  customer        BusinessCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  payments        BusinessOrderPayment[]
  statusHistory   BusinessOrderStatusHistory[]

  @@index([userId, ledgerId, orderedAt])
}

model BusinessCustomer {
  id          String   @id @default(uuid())
  userId      String
  name        String
  phone       String?
  email       String?
  socialLink  String?
  address     String?
  tags        String[] @default([])
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders      BusinessOrder[]

  @@unique([userId, phone])
  @@index([userId, name])
}

model BusinessOrderPayment {
  id        String   @id @default(uuid())
  userId    String
  orderId   String
  amount    Int
  method    String   @default("cash")
  note      String?
  paidAt    DateTime @default(now())
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     BusinessOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId, orderId, paidAt])
}

model BusinessOrderStatusHistory {
  id        String   @id @default(uuid())
  userId    String
  orderId   String
  fromStatus String?
  toStatus  String
  note      String?
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     BusinessOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId, orderId, createdAt])
}

model BusinessInventoryMovement {
  id          String   @id @default(uuid())
  userId      String
  productId   String
  type        String
  quantity    Int
  balanceAfter Int
  referenceType String?
  referenceId String?
  note        String?
  createdAt   DateTime @default(now())

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     BusinessProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId, productId, createdAt])
}

model BusinessOrderItem {
  id           String   @id @default(uuid())
  orderId      String
  productId    String
  productName  String
  quantity     Int
  unitPrice    Int      @default(0)
  unitCost     Int      @default(0)

  order        BusinessOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      BusinessProduct @relation(fields: [productId], references: [id])
}

model BusinessExpense {
  id          String   @id @default(uuid())
  userId      String
  ledgerId    String
  category    String
  amount      Int      @default(0)
  note        String?
  spentAt     DateTime
  createdAt   DateTime @default(now())

  user        User           @relation(fields: [userId], references: [id])
  ledger      BusinessLedger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)

  @@index([userId, ledgerId, spentAt])
}
