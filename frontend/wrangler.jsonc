{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "billy-cloudflare",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public", "enable_nodejs_http_modules"],
  "triggers": {
    "crons": ["0 2 * * *"]
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "c2008c1a1de94c329b58fa97fba307ec",
      "remote": true
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "billy-cloudflare"
    }
  ]
}
