{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:vercel": "node scripts/vercel-build.mjs",
    "build:cloudflare": "opennextjs-cloudflare build && node scripts/build-cloudflare-fast-paths.mjs",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint",
    "test:theme": "node scripts/test-theme.mjs && node scripts/test-styled-select.mjs",
    "test:profile": "node scripts/test-account-profile.mjs",
    "test:db": "node scripts/test-db-runtime.mjs",
    "test:cloudflare": "node scripts/test-cloudflare-fast-paths.mjs && node scripts/test-cloudflare-schedule.mjs",
    "test:sounds": "node scripts/test-sound-effects.mjs",
    "test:finance": "node scripts/test-finance-deletion.mjs && node scripts/test-finance-updates.mjs && node scripts/test-finance-queue.mjs && node scripts/test-finance-loading.mjs",
    "test:subscriptions": "node scripts/test-subscriptions.mjs",
    "test:vouchers": "node scripts/test-vouchers.mjs && node scripts/test-voucher-groups.mjs && node scripts/test-voucher-orders.mjs",
    "test:invoices": "node scripts/test-invoice-image.mjs",
    "test:sales": "node scripts/test-sales-orders.mjs && node scripts/test-voucher-orders.mjs",
    "test:push": "node scripts/test-web-push.mjs",
    "push:keys": "node scripts/generate-push-keys.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@opennextjs/cloudflare": "^1.20.16",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "bwip-js": "^4.11.4",
    "canvas-confetti": "^1.9.4",
    "epubjs": "^0.3.93",
    "exceljs": "^4.4.0",
    "framer-motion": "^13.0.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.30.0",
    "next": "^16.4.5",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-reader": "^2.0.15",
    "tesseract.js": "^7.0.0",
    "web-push": "^3.6.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "esbuild": "0.28.2",
    "eslint-config-next": "^16.4.5",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.158.0"
  }
}
